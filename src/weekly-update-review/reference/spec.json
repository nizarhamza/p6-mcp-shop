{
  "spec": 1,
  "steps": [
    {"id": "sum", "tool": "p6_project_summary", "args": {"project": "{project}"},
     "why": "data date, percent complete, finish dates, baseline"},
    {"id": "prog", "tool": "p6_progress_check", "args": {"project": "{project}", "sample_size": 5},
     "why": "out of sequence links, status checks"},
    {"id": "cp", "tool": "p6_critical_path", "args": {"project": "{project}", "limit": 15},
     "why": "critical open activities"},
    {"id": "la", "tool": "p6_lookahead", "args": {"project": "{project}", "weeks": "{weeks}", "critical_only": true, "limit": 20},
     "why": "critical activities of the look-ahead window"},
    {"id": "cmp", "tool": "p6_compare_projects", "args": {"project": "{project}", "section": "activities", "min_variance_days": 5, "limit": 15},
     "optional": true, "why": "slippage against the project baseline"}
  ],
  "slots": {
    "data_date": {"step": "sum", "path": "schedule_state.data_date", "format": "date", "meaning": "data date"},
    "last_f9": {"step": "sum", "path": "schedule_state.last_schedule_date", "format": "datetime", "meaning": "last schedule run (F9)"},
    "stale": {"step": "sum", "path": "schedule_state.stale", "format": "flag", "meaning": "changed by this server after the last F9"},
    "units_pct": {"step": "sum", "path": "percent_complete.units", "format": "pct1", "unit": "%", "meaning": "units % complete, labor and nonlabor"},
    "physical_pct": {"step": "sum", "path": "percent_complete.physical", "format": "pct1", "unit": "%", "meaning": "physical % weighted by budget units"},
    "duration_pct": {"step": "sum", "path": "percent_complete.duration", "format": "pct1", "unit": "%", "meaning": "duration % complete"},
    "completed_pct": {"step": "sum", "path": "percent_complete.activities_completed", "format": "pct1", "unit": "%", "meaning": "completed / all activities"},
    "mismatch": {"step": "sum", "path": "percent_complete.units_vs_physical_mismatch", "format": "int", "meaning": "activities whose physical % and units % differ"},
    "bl_planned_pct": {"step": "sum", "path": "baseline.planned_units_pct_at_data_date", "format": "pct1", "unit": "%", "meaning": "baseline planned units % at the data date"},
    "spi_units": {"step": "sum", "path": "baseline.spi_units", "format": "n2", "meaning": "earned units / baseline planned units"},
    "scheduled_finish": {"step": "sum", "path": "dates.scheduled_finish", "format": "date", "meaning": "scheduled finish"},
    "must_finish": {"step": "sum", "path": "dates.must_finish_by", "format": "date", "meaning": "must finish by"},
    "vs_must_cd": {"step": "sum", "path": "dates.finish_vs_must_finish_by_cd", "format": "n1", "unit": "cd", "meaning": "scheduled finish minus must finish by"},
    "vs_must_wd": {"step": "sum", "path": "dates.finish_vs_must_finish_by_wd", "format": "n1", "unit": "wd proj", "meaning": "the same in working days"},
    "baseline_used": {"step": "sum", "path": "baseline.used", "format": "text", "meaning": "baseline used (null: none)"},
    "vs_bl_cd": {"step": "sum", "path": "baseline.finish_variance_cd", "format": "n1", "unit": "cd", "meaning": "scheduled finish minus the baseline's"},
    "vs_bl_wd": {"step": "sum", "path": "baseline.finish_variance_wd", "format": "n1", "unit": "wd proj", "meaning": "the same in working days"},
    "cp_definition": {"step": "cp", "path": "definition", "format": "text", "meaning": "definition of critical"},
    "critical": {"step": "cp", "path": "total", "format": "int", "meaning": "critical open activities"},
    "neg_float": {"step": "cp", "path": "counts.negative_float", "format": "int", "meaning": "open activities with negative float"},
    "cmp_error": {"step": "cmp", "path": "error", "format": "text", "meaning": "error of the comparison (no baseline)"},
    "later": {"step": "cmp", "path": "summary.activities.later", "format": "int", "meaning": "matched activities finishing later"},
    "earlier": {"step": "cmp", "path": "summary.activities.earlier", "format": "int", "meaning": "matched activities finishing earlier"},
    "oos_links": {"step": "prog", "path": "out_of_sequence_total.links", "format": "int", "meaning": "out of sequence links"},
    "logic_mode": {"step": "prog", "path": "logic_option.mode", "format": "text", "meaning": "out of sequence option of F9"},
    "chk_active": {"step": "prog", "path": "status_checks.active_without_start.count", "format": "int", "meaning": "in progress, no actual start"},
    "chk_complete": {"step": "prog", "path": "status_checks.complete_with_remaining_or_no_finish.count", "format": "int", "meaning": "completed, remaining duration or no actual finish"},
    "chk_after_dd": {"step": "prog", "path": "status_checks.actual_after_data_date.count", "format": "int", "meaning": "actual dates after the data date"},
    "la_from": {"step": "la", "path": "window.from", "format": "datetime", "meaning": "window start"},
    "la_to": {"step": "la", "path": "window.to", "format": "datetime", "meaning": "window end (excluded)"},
    "la_critical": {"step": "la", "path": "counts.critical", "format": "int", "meaning": "critical activities in the window"},
    "la_in_progress": {"step": "la", "path": "counts.in_progress", "format": "int", "meaning": "of them in progress"},
    "la_starting": {"step": "la", "path": "counts.starting", "format": "int", "meaning": "of them starting in the window"},
    "la_finishing": {"step": "la", "path": "counts.finishing", "format": "int", "meaning": "of them finishing in the window"}
  },
  "tables": {
    "critical": {"step": "cp", "rows": "rows", "cap": 15, "noun": "critical activities", "empty": "No critical open activity.",
     "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "status", "head": "Status", "path": "status_code", "format": "text"},
      {"key": "start", "head": "Early start", "path": "early_start_date", "format": "date"},
      {"key": "finish", "head": "Early finish", "path": "early_end_date", "format": "date"},
      {"key": "rem", "head": "Remaining (d)", "path": "rem_dur_d", "format": "n1", "unit": "d"},
      {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"}]},
    "slip_causes": {"step": "cmp", "rows": "summary.activities.slip_causes", "cap": 10, "noun": "causes", "empty": "No matched activity.",
     "columns": [
      {"key": "cause", "head": "Cause", "path": "_key", "format": "text"},
      {"key": "n", "head": "Activities", "path": "_value", "format": "int"}]},
    "slipped": {"step": "cmp", "rows": "rows", "cap": 15, "noun": "activities", "empty": "No activity moved by 5 calendar days or more.",
     "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "name"], "format": "id_name"},
      {"key": "change", "head": "Change", "path": "change", "format": "text"},
      {"key": "finish", "head": "Finish", "path": "finish", "format": "date"},
      {"key": "bl_finish", "head": "Baseline finish", "path": "other_finish", "format": "date"},
      {"key": "var", "head": "Finish variance (wd)", "path": "variance_wd", "format": "n1", "unit": "wd"},
      {"key": "start_var", "head": "Start variance (wd)", "path": "start_variance_wd", "format": "n1", "unit": "wd"},
      {"key": "dur", "head": "Duration delta (wd)", "path": "duration_delta_wd", "format": "n1", "unit": "wd"},
      {"key": "cause", "head": "Cause", "path": "slip_cause", "format": "text"}]},
    "oos": {"step": "prog", "rows": "out_of_sequence", "cap": 10, "noun": "link types", "empty": "No link checked.",
     "columns": [
      {"key": "type", "head": "Type", "path": "_key", "format": "text"},
      {"key": "links", "head": "Links", "path": "links", "format": "int"},
      {"key": "succ", "head": "Successors", "path": "successors", "format": "int"}]},
    "status_checks": {"step": "prog", "rows": "status_checks", "cap": 10, "noun": "checks", "empty": "No check ran.",
     "columns": [
      {"key": "check", "head": "Check", "path": "_key", "format": "text"},
      {"key": "count", "head": "Activities", "path": "count", "format": "int"}]},
    "lookahead": {"step": "la", "rows": "rows", "cap": 20, "noun": "activities", "empty": "No critical activity in the window.",
     "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "window", "head": "In the window", "path": "window", "format": "list"},
      {"key": "start", "head": "Forecast start", "path": "fcst_start", "format": "date"},
      {"key": "finish", "head": "Forecast finish", "path": "fcst_finish", "format": "date"},
      {"key": "sw", "head": "Start week", "path": "start_week", "format": "int", "none": "outside"},
      {"key": "fw", "head": "Finish week", "path": "finish_week", "format": "int", "none": "outside"},
      {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"}]}
  },
  "checks": [
    {"equal": ["sum.schedule_state.data_date", "prog.schedule_state.data_date", "cp.schedule_state.data_date", "la.schedule_state.data_date"], "text": "same data date"},
    {"equal": ["sum.schedule_state.last_schedule_date", "cp.schedule_state.last_schedule_date", "la.schedule_state.last_schedule_date"], "text": "same last F9"},
    {"equal": ["sum.critical.critical", "cp.total"], "text": "same critical count"},
    {"equal": ["sum.critical.negative_float", "cp.counts.negative_float"], "text": "same negative float count"},
    {"equal": ["sum.baseline.used", "cmp.other"], "text": "same baseline"}
  ]
}
