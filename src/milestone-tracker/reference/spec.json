{
  "spec": 1,
  "steps": [
    {"id": "ms", "tool": "p6_milestones", "args": {"project": "{project}", "baseline": "{baseline}", "limit": 30},
     "why": "every milestone by date with its baseline date and variance, counts, baseline, must finish date"},
    {"id": "late", "tool": "p6_milestones", "args": {"project": "{project}", "baseline": "{baseline}", "open_only": true, "order": "variance", "limit": 10},
     "why": "open milestones, largest variance in working days first"},
    {"id": "drv", "tool": "p6_driving_path", "args": {"project": "{project}", "target": "{=late.rows.0.task_code}", "limit": 15},
     "why": "driving predecessors of the open milestone with the largest variance"},
    {"id": "ct", "tool": "p6_milestones", "args": {"project": "{project}", "baseline": "{baseline}", "codes": "{contract}", "limit": 20}, "when": "contract",
     "why": "the contract milestones given"}
  ],
  "slots": {
    "data_date": {"step": "ms", "path": "schedule_state.data_date", "format": "date", "meaning": "data date of the project"},
    "last_f9": {"step": "ms", "path": "schedule_state.last_schedule_date", "format": "datetime", "meaning": "last schedule run (F9) in P6"},
    "stale": {"step": "ms", "path": "schedule_state.stale", "format": "flag", "meaning": "this server changed the project after the last F9"},
    "baseline_project": {"step": "ms", "path": "baseline.project", "format": "text", "none": "none", "meaning": "Project ID of the baseline compared with (null: no baseline)"},
    "baseline_dates": {"step": "ms", "path": "baseline.dates", "format": "text", "meaning": "baseline date rule: current = the baseline's actual else forecast date"},
    "must_finish": {"step": "ms", "path": "must_finish", "format": "date", "meaning": "project must finish by date (PROJECT.plan_end_date)"},
    "critical_definition": {"step": "ms", "path": "critical_definition", "format": "text", "meaning": "the project's definition of critical"},
    "n_milestones": {"step": "ms", "path": "counts.milestones", "format": "int", "unit": "count", "meaning": "milestones of the project (start and finish milestones)"},
    "n_completed": {"step": "ms", "path": "counts.completed", "format": "int", "unit": "count", "meaning": "completed milestones"},
    "n_open": {"step": "ms", "path": "counts.open", "format": "int", "unit": "count", "meaning": "milestones not completed"},
    "n_critical": {"step": "ms", "path": "counts.critical", "format": "int", "unit": "count", "meaning": "open milestones that are critical"},
    "n_late": {"step": "ms", "path": "counts.late", "format": "int", "unit": "count", "meaning": "milestones later than their baseline date"},
    "n_early": {"step": "ms", "path": "counts.early", "format": "int", "unit": "count", "meaning": "milestones earlier than their baseline date"},
    "n_on_time": {"step": "ms", "path": "counts.on_time", "format": "int", "unit": "count", "meaning": "milestones on their baseline date (within 5 minutes of working time)"},
    "n_no_baseline": {"step": "ms", "path": "counts.no_baseline", "format": "int", "unit": "count", "meaning": "milestones without a baseline date"},
    "n_open_late": {"step": "ms", "path": "counts.open_late", "format": "int", "unit": "count", "meaning": "open milestones later than their baseline date"},
    "target_code": {"step": "drv", "path": "target.task_code", "format": "text", "meaning": "Activity ID of the open milestone with the largest variance (null: no open milestone)"},
    "target_name": {"step": "drv", "path": "target.task_name", "format": "text", "meaning": "its name"},
    "target_tf": {"step": "drv", "path": "target.total_float_d", "format": "n1", "unit": "d", "meaning": "its total float"},
    "ct_def": {"step": "ct", "path": "critical_definition", "format": "text", "meaning": "set when ct ran"},
    "ct_not_found": {"step": "ct", "path": "not_found", "format": "list", "meaning": "contract IDs not found"}
  },
  "tables": {
    "all": {
      "step": "ms", "rows": "rows", "cap": 30, "noun": "milestones", "empty": "This project has no milestone.",
      "meaning": "Every milestone by date then Activity ID.",
      "columns": [
        {"key": "activity", "head": "Milestone", "path": ["task_code", "task_name"], "format": "id_name"},
        {"key": "type", "head": "Type", "path": "task_type", "format": "text"},
        {"key": "status", "head": "Status", "path": "status_code", "format": "text"},
        {"key": "date", "head": "Date", "path": "date", "format": "date"},
        {"key": "kind", "head": "Date kind", "path": "date_kind", "format": "text"},
        {"key": "bl_date", "head": "Baseline date", "path": "baseline_date", "format": "date"},
        {"key": "var_wd", "head": "Variance (wd)", "path": "variance_wd", "format": "n1", "unit": "wd"},
        {"key": "var_cd", "head": "Variance (cd)", "path": "variance_cd", "format": "n1", "unit": "cd"},
        {"key": "vs", "head": "Vs baseline", "path": "vs_baseline", "format": "text"},
        {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"},
        {"key": "critical", "head": "Critical", "path": "critical", "format": "flag"}
      ]
    },
    "late": {
      "step": "late", "rows": "rows", "cap": 10, "noun": "open milestones", "empty": "No open milestone.",
      "meaning": "Open milestones, largest variance in working days first, without a baseline date last, then by date.",
      "columns": [
        {"key": "activity", "head": "Milestone", "path": ["task_code", "task_name"], "format": "id_name"},
        {"key": "date", "head": "Forecast", "path": "date", "format": "date"},
        {"key": "bl_date", "head": "Baseline date", "path": "baseline_date", "format": "date"},
        {"key": "var_wd", "head": "Variance (wd)", "path": "variance_wd", "format": "n1", "unit": "wd"},
        {"key": "var_cd", "head": "Variance (cd)", "path": "variance_cd", "format": "n1", "unit": "cd"},
        {"key": "vs", "head": "Vs baseline", "path": "vs_baseline", "format": "text"},
        {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"},
        {"key": "critical", "head": "Critical", "path": "critical", "format": "flag"}
      ]
    },
    "drivers": {
      "step": "drv", "rows": "rows", "cap": 15, "noun": "activities", "empty": "No driving predecessor.",
      "meaning": "The milestone (level 0) and its open driving predecessors, by level then early finish.",
      "columns": [
        {"key": "level", "head": "Level", "path": "level", "format": "int"},
        {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
        {"key": "status", "head": "Status", "path": "status_code", "format": "text"},
        {"key": "es", "head": "Early start", "path": "early_start", "format": "date"},
        {"key": "ef", "head": "Early finish", "path": "early_finish", "format": "date"},
        {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"},
        {"key": "succ", "head": "Drives", "path": ["successor", "successor_name"], "format": "id_name"},
        {"key": "link", "head": "Link", "path": "type", "format": "text"},
        {"key": "lag", "head": "Lag (d)", "path": "lag_d", "format": "n1", "unit": "d"}
      ]
    },
    "contract": {
      "step": "ct", "rows": "rows", "cap": 20, "noun": "contract milestones", "empty": "No contract milestone found.",
      "meaning": "Contract milestones by date.",
      "columns": [
        {"key": "activity", "head": "Milestone", "path": ["task_code", "task_name"], "format": "id_name"},
        {"key": "cstr", "head": "Constraint", "path": "cstr_label", "format": "text", "none": "none"},
        {"key": "cdate", "head": "Constraint date", "path": "cstr_date", "format": "date"},
        {"key": "hard", "head": "Hard", "path": "hard_constraint", "format": "flag"},
        {"key": "preds", "head": "Predecessors", "path": "predecessor_count", "format": "int", "unit": "count"},
        {"key": "date", "head": "Forecast", "path": "date", "format": "date"},
        {"key": "vs_c", "head": "Forecast - constraint (wd)", "path": "vs_constraint_wd", "format": "n1", "unit": "wd"},
        {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"},
        {"key": "origin", "head": "Float comes from", "path": "float_origin_explanation", "format": "text"}
      ]
    },
    "roots": {
      "step": "drv", "rows": "drivers_at_root", "cap": 10, "noun": "chain starts", "empty": "No chain start found.",
      "meaning": "What starts each driving chain: data_date, constraint, actual_date (progress), open_start (no predecessor), completed_predecessor, unexplained.",
      "columns": [
        {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
        {"key": "type", "head": "Starts from", "path": "type", "format": "text"},
        {"key": "date", "head": "Date", "path": "date", "format": "date"}
      ]
    }
  },
  "checks": [
    {"equal": ["ms.schedule_state.data_date", "late.schedule_state.data_date"], "text": "same data date"},
    {"equal": ["ms.schedule_state.data_date", "drv.data_date"], "text": "same data date (driving path)"},
    {"equal": ["ms.must_finish", "late.must_finish"], "text": "same must finish date"},
    {"equal": ["ms.counts.open", "late.counts.milestones"], "text": "open milestones = milestones of the open list"},
    {"equal": ["ms.counts.open_late", "late.counts.late"], "text": "same open late milestones"},
    {"equal": ["ms.counts.critical", "late.counts.critical"], "text": "same critical milestones"},
    {"equal": ["late.rows.0.total_float_d", "drv.target.total_float_d"], "text": "same total float of the first open milestone"},
    {"equal": ["ms.schedule_state.data_date", "ct.schedule_state.data_date"], "text": "same data date (contract)"}
  ]
}
