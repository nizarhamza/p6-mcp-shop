{
  "spec": 1,
  "steps": [
    {"id": "act", "tool": "p6_get_activity", "args": {"project": "{project}", "task_code": "{task_code}"}, "why": "the activity today"},
    {"id": "drv", "tool": "p6_driving_path", "args": {"project": "{project}", "target": "{task_code}", "limit": 15}, "why": "what drives it"},
    {"id": "fo", "tool": "p6_float_origin", "args": {"project": "{project}", "task_code": "{task_code}", "limit": 10}, "optional": true, "why": "where its total float comes from"},
    {"id": "wi", "tool": "p6_schedule_whatif", "args": {"project": "{project}", "edits": [{"op": "duration", "task_code": "{task_code}", "add_remaining_days": "{delay_days}"}], "limit": 15}, "why": "the delay applied in memory"}
  ],
  "slots": {
    "data_date": {"step": "act", "path": "schedule_state.data_date", "format": "date", "meaning": "data date"},
    "last_f9": {"step": "act", "path": "schedule_state.last_schedule_date", "format": "datetime", "meaning": "last schedule run (F9) in P6"},
    "stale": {"step": "act", "path": "schedule_state.stale", "format": "flag", "meaning": "changed by this server after the last F9"},
    "act_name": {"step": "act", "path": "task_name", "format": "text", "meaning": "activity name"},
    "act_status": {"step": "act", "path": "status_code", "format": "text", "meaning": "activity status"},
    "act_wbs": {"step": "act", "path": "wbs_name", "format": "text", "meaning": "WBS node name"},
    "act_calendar": {"step": "act", "path": "calendar.name", "format": "text", "meaning": "calendar name"},
    "act_actual_start": {"step": "act", "path": "act_start_date", "format": "date", "meaning": "actual start (null: not started)"},
    "act_es": {"step": "act", "path": "early_start_date", "format": "date", "meaning": "early start"},
    "act_ef": {"step": "act", "path": "early_end_date", "format": "date", "meaning": "early finish"},
    "act_lf": {"step": "act", "path": "late_end_date", "format": "date", "meaning": "late finish"},
    "act_orig_d": {"step": "act", "path": "orig_dur_d", "format": "n1", "unit": "d", "meaning": "original duration"},
    "act_rem_d": {"step": "act", "path": "rem_dur_d", "format": "n1", "unit": "d", "meaning": "remaining duration"},
    "act_pct": {"step": "act", "path": "phys_complete_pct", "format": "pct1", "unit": "%", "meaning": "physical % complete"},
    "act_tf": {"step": "act", "path": "total_float_d", "format": "n1", "unit": "d", "meaning": "total float"},
    "act_ff": {"step": "act", "path": "free_float_d", "format": "n1", "unit": "d", "meaning": "free float"},
    "act_longest": {"step": "act", "path": "driving_path_flag", "format": "text", "meaning": "on the longest path (Y or N)"},
    "fo_error": {"step": "fo", "path": "error", "format": "text", "meaning": "why the float origin failed"},
    "origin_type": {"step": "fo", "path": "origin.type", "format": "text", "meaning": "source of the late dates"},
    "origin_activity": {"step": "fo", "path": ["origin.task_code", "origin.task_name"], "format": "id_name", "meaning": "activity at the source (null: several sources)"},
    "origin_date": {"step": "fo", "path": "origin.date", "format": "date", "meaning": "date at the source"},
    "explanation": {"step": "fo", "path": "explanation", "format": "text", "meaning": "the float origin in words"},
    "edit_applied": {"step": "wi", "path": "edits.0", "format": "text", "meaning": "the edit as applied"},
    "finish_before": {"step": "wi", "path": "project_finish.before", "format": "date", "meaning": "project finish of the last F9"},
    "finish_after": {"step": "wi", "path": "project_finish.after", "format": "date", "meaning": "project finish with the delay"},
    "finish_delta_cd": {"step": "wi", "path": "project_finish.delta_cd", "format": "n1", "unit": "cd", "meaning": "project finish change"},
    "finish_delta_wd": {"step": "wi", "path": "project_finish.delta_wd", "format": "n1", "unit": "wd", "meaning": "same, finish activity's calendar"},
    "fc_definition": {"step": "wi", "path": "float_change.definition", "format": "text", "meaning": "definition of critical used"},
    "critical_before": {"step": "wi", "path": "float_change.critical_before", "format": "int", "meaning": "critical open activities before"},
    "critical_after": {"step": "wi", "path": "float_change.critical_after", "format": "int", "meaning": "critical open activities after"},
    "negative_before": {"step": "wi", "path": "float_change.negative_float_before", "format": "int", "meaning": "open activities with negative float, before"},
    "negative_after": {"step": "wi", "path": "float_change.negative_float_after", "format": "int", "meaning": "same, after"},
    "became_critical": {"step": "wi", "path": "float_change.became_critical", "format": "int", "meaning": "open activities that become critical"},
    "no_longer_critical": {"step": "wi", "path": "float_change.no_longer_critical", "format": "int", "meaning": "open activities no longer critical"},
    "changed_total": {"step": "wi", "path": "total", "format": "int", "meaning": "activities whose dates or float move"},
    "engine_trusted": {"step": "wi", "path": "engine.trusted", "format": "flag", "meaning": "engine matches the last F9 (rate >= 0.99)"},
    "engine_mismatched": {"step": "wi", "path": "engine.open_mismatched", "format": "int", "meaning": "open activities differing from the last F9"}
  },
  "tables": {
    "drivers": {"step": "drv", "rows": "rows", "cap": 15, "noun": "activities", "empty": "No driving predecessor.", "meaning": "Level 0 = the activity, then its open driving predecessors.", "columns": [
      {"key": "level", "head": "Level", "path": "level", "format": "int"},
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "es", "head": "Early start", "path": "early_start", "format": "date"},
      {"key": "ef", "head": "Early finish", "path": "early_finish", "format": "date"},
      {"key": "tf", "head": "Total float (d)", "path": "total_float_d", "format": "n1", "unit": "d"},
      {"key": "succ", "head": "Drives", "path": ["successor", "successor_name"], "format": "id_name"},
      {"key": "link", "head": "Link", "path": "type", "format": "text"},
      {"key": "lag", "head": "Lag (d)", "path": "lag_d", "format": "n1", "unit": "d"}]},
    "roots": {"step": "drv", "rows": "drivers_at_root", "cap": 10, "noun": "chain starts", "empty": "No chain start found.", "meaning": "What starts each driving chain.", "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "type", "head": "Starts from", "path": "type", "format": "text"},
      {"key": "date", "head": "Date", "path": "date", "format": "date"}]},
    "milestones": {"step": "wi", "rows": "milestones", "cap": 10, "noun": "milestones", "empty": "No milestone to compare.", "meaning": "The finish activity and every constrained activity.", "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "before", "head": "Finish before", "path": "finish_before", "format": "date"},
      {"key": "after", "head": "Finish after", "path": "finish_after", "format": "date"},
      {"key": "delta_cd", "head": "Change (cd)", "path": "delta_cd", "format": "n1", "unit": "cd"},
      {"key": "tf_before", "head": "Total float before (d)", "path": "total_float_d_before", "format": "n1", "unit": "d"},
      {"key": "tf_after", "head": "Total float after (d)", "path": "total_float_d_after", "format": "n1", "unit": "d"}]},
    "became": {"step": "wi", "rows": "float_change.became_critical_rows", "cap": 15, "noun": "activities", "empty": "No activity becomes critical.", "meaning": "Open activities that become critical.", "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "tf_before", "head": "Total float before (d)", "path": "total_float_d_before", "format": "n1", "unit": "d"},
      {"key": "tf_after", "head": "Total float after (d)", "path": "total_float_d_after", "format": "n1", "unit": "d"}]},
    "changed": {"step": "wi", "rows": "rows", "cap": 15, "noun": "activities that move", "empty": "No activity moves.", "meaning": "Activities whose dates or float move, largest finish change first.", "columns": [
      {"key": "activity", "head": "Activity", "path": ["task_code", "task_name"], "format": "id_name"},
      {"key": "ef_before", "head": "Early finish before", "path": "early_finish_before", "format": "date"},
      {"key": "ef_after", "head": "Early finish after", "path": "early_finish_after", "format": "date"},
      {"key": "delta_cd", "head": "Finish change (cd)", "path": "finish_delta_cd", "format": "n1", "unit": "cd"},
      {"key": "tf_before", "head": "Total float before (d)", "path": "total_float_d_before", "format": "n1", "unit": "d"},
      {"key": "tf_after", "head": "Total float after (d)", "path": "total_float_d_after", "format": "n1", "unit": "d"}]}
  },
  "checks": [
    {"equal": ["act.schedule_state.data_date", "drv.data_date", "wi.schedule_state.data_date"], "text": "data date: activity, driving path, what-if"},
    {"equal": ["act.schedule_state.data_date", "fo.schedule_state.data_date"], "text": "data date: activity, float origin"},
    {"equal": ["act.total_float_d", "drv.target.total_float_d"], "text": "total float: activity, driving path"},
    {"equal": ["act.total_float_d", "fo.activity.total_float_d"], "text": "total float: activity, float origin"},
    {"equal": ["act.early_end_date", "drv.target.early_finish"], "text": "early finish: activity, driving path"},
    {"equal": ["fo.project_finish", "wi.project_finish.before"], "text": "project finish before the delay"}
  ]
}
